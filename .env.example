# ===========================
# BirdEye Environment Variables
# ===========================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ----- PostgreSQL + PostGIS -----
POSTGRES_USER=birdeye_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=birdeye
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Directus CMS -----
DIRECTUS_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET
DIRECTUS_ADMIN_EMAIL=admin@birdeye.local
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ----- Stadia Maps / Map Engine -----
NEXT_PUBLIC_STADIA_MAPS_API_KEY=YOUR_STADIA_MAPS_API_KEY_HERE
# Or if using Mapbox:
# NEXT_PUBLIC_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# ----- AI Service (FastAPI) -----
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
DIRECTUS_SERVICE_TOKEN=GENERATED_AFTER_DIRECTUS_SETUP
AI_SERVICE_PORT=8000

# ----- Next.js Frontend -----
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
